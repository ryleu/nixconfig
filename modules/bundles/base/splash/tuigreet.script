# boot splash that looks like tuigreet

### GRID ###

# the kernel console switches to a 16x32 font on high resolution panels
if (Window.GetWidth() >= 2560 || Window.GetHeight() >= 1440) {
  cell_w = 16;
  cell_h = 32;
} else {
  cell_w = 8;
  cell_h = 16;
}

screen_cols = Math.Int(Window.GetWidth() / cell_w);
screen_rows = Math.Int(Window.GetHeight() / cell_h);

box_cols = 80;
if (box_cols > screen_cols - 2) box_cols = screen_cols - 2;
box_rows = 5;
box_col = Math.Int((screen_cols - box_cols) / 2);
box_row = Math.Int((screen_rows - box_rows) / 2);

line_px = Math.Int(cell_h / 16);
if (line_px < 1) line_px = 1;

### COLORS ###

Window.SetBackgroundTopColor(@bg@);
Window.SetBackgroundBottomColor(@bg@);

fg_pixel = Image("fg.png");
bg_pixel = Image("bg.png");

### FONT ###

# pick the size whose glyphs are exactly one cell wide
font_family = "@font@";
probe = Image.Text("MMMMMMMMMM", 1, 1, 1, 1, font_family + " 20");
font_size = Math.Int(20 * (10 * cell_w) / probe.GetWidth());
if (font_size < 6) font_size = 6;
font = font_family + " " + font_size;

fun text_fg(string) {
  return Image.Text(string, @fg@, 1, font);
}

fun text_bg(string) {
  return Image.Text(string, @bg@, 1, font);
}

fun text_error(string) {
  return Image.Text(string, @error@, 1, font);
}

# put a line of text on the grid, vertically centred in its row
fun place(sprite, image, col, row, z) {
  sprite.SetImage(image);
  sprite.SetPosition(
    col * cell_w,
    row * cell_h + Math.Int((cell_h - image.GetHeight()) / 2),
    z
  );
}

fun rect(pixel, x, y, w, h, z) {
  local.sprite = Sprite(pixel.Scale(w, h));
  local.sprite.SetPosition(x, y, z);
  return local.sprite;
}

### BOX ###

# lines run through the middle of their cells, like box drawing characters
left = box_col * cell_w + Math.Int(cell_w / 2);
right = (box_col + box_cols - 1) * cell_w + Math.Int(cell_w / 2);
top = box_row * cell_h + Math.Int(cell_h / 2);
bottom = (box_row + box_rows - 1) * cell_h + Math.Int(cell_h / 2);

border.top = rect(fg_pixel, left, top, right - left + line_px, line_px, 1);
border.bottom = rect(fg_pixel, left, bottom, right - left + line_px, line_px, 1);
border.left = rect(fg_pixel, left, top, line_px, bottom - top + line_px, 1);
border.right = rect(fg_pixel, right, top, line_px, bottom - top + line_px, 1);

### TITLE ###

title.mask = Sprite();
title.sprite = Sprite();

fun set_title(string) {
  local.image = text_fg(string);
  # hide the border behind the title, with a space either side
  title.mask.SetImage(bg_pixel.Scale(local.image.GetWidth() + 2 * cell_w, cell_h));
  title.mask.SetPosition((box_col + 1) * cell_w, box_row * cell_h, 2);
  place(title.sprite, local.image, box_col + 2, box_row, 3);
}

### CONTENT ###

content.sprite = Sprite();
notice.sprite = Sprite();

fun set_content(string) {
  place(content.sprite, text_fg(string), box_col + 2, box_row + 2, 3);
}

fun set_notice(string) {
  place(notice.sprite, text_error(string), box_col + 2, box_row + box_rows + 1, 3);
}

fun clear_notice() {
  notice.sprite.SetImage(text_fg(""));
}

### STATUS BAR ###

key.image = text_bg("ESC");
key.back = rect(
  fg_pixel,
  cell_w,
  (screen_rows - 1) * cell_h,
  key.image.GetWidth() + 2 * cell_w,
  cell_h,
  1
);
key.sprite = Sprite();
place(key.sprite, key.image, 2, screen_rows - 1, 2);
hint.sprite = Sprite();
place(hint.sprite, text_fg("Show boot log"), 7, screen_rows - 1, 2);

### STATES ###

fun contains(haystack, needle) {
  local.h = String(haystack);
  local.n = String(needle);
  local.hl = local.h.Length();
  local.nl = local.n.Length();
  for (local.i = 0; local.i + local.nl <= local.hl; local.i++) {
    if (local.h.SubString(local.i, local.i + local.nl) == local.n) return 1;
  }
  return 0;
}

# titles for different modes
fun normal_title() {
  local.mode = Plymouth.GetMode();
  if (local.mode == "shutdown") return "Shutting down @hostName@";
  if (local.mode == "reboot") return "Rebooting @hostName@";
  if (local.mode == "suspend") return "Suspending @hostName@";
  if (local.mode == "resume") return "Resuming @hostName@";
  return "Booting @hostName@";
}

fun normal_callback() {
  set_title(normal_title());
  set_content("Please wait…");
  clear_notice();
}

fun password_callback(prompt_text, bullet_count) {
  # systemd's prompts are long and start with an emoji the font lacks, so
  # use a tuigreet sized label instead
  if (contains(prompt_text, "PIN")) {
    local.line = "PIN: ";
  } else if (contains(prompt_text, "recovery")) {
    local.line = "Recovery key: ";
  } else {
    local.line = "Passphrase: ";
  }
  for (local.i = 0; local.i < bullet_count; local.i++) {
    local.line = local.line + "*";
  }
  set_title("Unlock @hostName@");
  set_content(local.line);
}

fun question_callback(prompt_text, entry) {
  set_title("Unlock @hostName@");
  set_content(prompt_text + " " + entry);
}

fun message_callback(string) {
  set_notice(string);
}

fun quit_callback() {
  clear_notice();
}

Plymouth.SetDisplayNormalFunction(normal_callback);
Plymouth.SetDisplayPasswordFunction(password_callback);
Plymouth.SetDisplayQuestionFunction(question_callback);
Plymouth.SetMessageFunction(message_callback);
Plymouth.SetQuitFunction(quit_callback);

normal_callback();
